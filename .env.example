# Copy to .env and fill in. .env is never served to the browser.

# Public address of the site (used for Stripe return links and email links)
SITE_URL=http://localhost:5510

# Password for the shop dashboard at /admin.html
ADMIN_PASSWORD=
# Long random string that signs dashboard logins (keeps people signed in across restarts)
SESSION_SECRET=

# Stripe (dashboard.stripe.com > Developers > API keys). Leave empty for demo mode (no real charges).
# Use sk_test_... while testing, sk_live_... to take real deposits.
STRIPE_SECRET_KEY=
# From the webhook endpoint pointing at <SITE_URL>/api/stripe/webhook
# (events: checkout.session.completed, checkout.session.expired)
STRIPE_WEBHOOK_SECRET=

# Optional texts through twilio.com: customers get their repair code when they book,
# and the shop's status updates by text. US numbers need A2P 10DLC registration in Twilio first.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number (+16315550123) or a Messaging Service SID (MG...)
TWILIO_FROM=

# Optional: year-accurate studio car pictures (transparent PNG) on the repair tracker, from imagin.studio.
# Without it the tracker uses the model's Wikipedia photo.
IMAGIN_CUSTOMER_KEY=

# Optional emails through resend.com: the shop gets new bookings, customers get confirm/decline notes
RESEND_API_KEY=
NOTIFY_FROM=Good Shepard Auto Body <bookings@yourdomain.com>
NOTIFY_TO=

# Optional: Google reviews on the homepage (Google Cloud > APIs & Services: enable "Places API (New)",
# create an API key restricted to that API). Without it the section links to the Google listing instead.
GOOGLE_PLACES_KEY=

# Online estimate bookings are free. Set a dollar amount (e.g. 50) to require a deposit through Stripe instead.
DEPOSIT_DOLLARS=
# Google listing for reviews and photos (already set to Good Shepard Auto Body Inc.); only change if the listing moves
# GOOGLE_PLACE_ID=ChIJez3DBQBB6IkRHQVdJwoE-I8
